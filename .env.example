# Copy this file to .env.local and fill it in. .env.local is ignored by git; never commit it.
# This file is committed, so it must not hold passwords or keys.

# The backend, including /api. For a backend on your own machine use http://localhost:9000/api
NEXT_PUBLIC_API_URL=https://farmnomad-backend.onrender.com/api

# true  = sample data everywhere, no backend needed (the default if this line is missing)
# false = integrated routes use the backend above; the rest stay on sample data until integrated
NEXT_PUBLIC_USE_MOCKS=true
